# ==========================================
# 项目特定配置
# ==========================================

# Local AI/agent config
.claude/settings.local.json
.codex/
.agents/
.cursor/

# Markdown docs are local draft/discussion material for now. Re-enable and
# publish curated docs after the project reaches a stable implementation point.
*.md
!/README.md

# Local Trellis execution state and task logs.
# Keep .trellis/scripts, .trellis/spec, workflow, and config in Git; task/session
# records are local collaboration history rather than product source.
.trellis/tasks/
.trellis/workspace/
.trellis/.session-tasks/
.trellis/.developer

# Trellis task-local generated artifacts.
# Keep task PRDs/specs/research in Git. Treat artifacts as local scratch output;
# move any script/report that must be preserved into research/ or source dirs.
.trellis/tasks/**/artifacts/

